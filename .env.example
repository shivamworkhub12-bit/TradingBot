# Local development only. Copy this file to .env if you want to override defaults.
POSTGRES_DB=tradingbot
POSTGRES_USER=tradingbot
POSTGRES_PASSWORD=tradingbot_dev_password
POSTGRES_PORT=5432

# Kite Connect credentials: keep actual values only in your local .env file.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:8080/auth/kite/callback

# Disabled by default. This creates only local F&O paper trades, never Kite orders.
FNO_PAPER_AUTOMATION_ENABLED=false
FNO_PAPER_AUTOMATION_POLL_DELAY_MS=60000
# FIXED uses the contract fields below. DYNAMIC_NIFTY_TREND and DYNAMIC_BANKNIFTY_TREND run one
# index. DYNAMIC_INDEX_TREND evaluates the comma-separated indexes independently using EMA/RSI
# momentum, a 20-candle breakout, and an ATR activity filter. Paper only.
FNO_PAPER_AUTOMATION_MODE=FIXED
FNO_PAPER_AUTOMATION_DYNAMIC_UNDERLYINGS=NIFTY,BANKNIFTY
FNO_PAPER_AUTOMATION_CONFIRMATION_CANDLES=8
FNO_PAPER_AUTOMATION_MIN_EMA_SEPARATION_BPS=1
FNO_PAPER_AUTOMATION_BREAKOUT_PERIOD=20
FNO_PAPER_AUTOMATION_ATR_PERIOD=14
FNO_PAPER_AUTOMATION_MIN_ATR_BPS=2
FNO_PAPER_AUTOMATION_TRADING_SYMBOL=
FNO_PAPER_AUTOMATION_UNDERLYING=NIFTY
FNO_PAPER_AUTOMATION_EXPIRY=
FNO_PAPER_AUTOMATION_STRIKE=0
FNO_PAPER_AUTOMATION_OPTION_TYPE=PE
FNO_PAPER_AUTOMATION_LOT_SIZE=0
FNO_PAPER_AUTOMATION_LOTS=1
FNO_PAPER_AUTOMATION_ENTRY_PREMIUM=0
FNO_PAPER_AUTOMATION_MAX_OPTION_PREMIUM=250
FNO_PAPER_AUTOMATION_MIN_DAYS_TO_EXPIRY=7
FNO_PAPER_AUTOMATION_STOP_LOSS_PERCENT=25
FNO_PAPER_AUTOMATION_TARGET_PERCENT=25
# Optional per-index overrides. When omitted, the common values above are used.
FNO_PAPER_AUTOMATION_NIFTY_MAX_OPTION_PREMIUM=250
FNO_PAPER_AUTOMATION_BANKNIFTY_MAX_OPTION_PREMIUM=250
FNO_PAPER_AUTOMATION_NIFTY_STOP_LOSS_PERCENT=25
FNO_PAPER_AUTOMATION_BANKNIFTY_STOP_LOSS_PERCENT=25
FNO_PAPER_AUTOMATION_NIFTY_TARGET_PERCENT=25
FNO_PAPER_AUTOMATION_BANKNIFTY_TARGET_PERCENT=25
# Do not open a new paper position at or after this IST time. Forced exit remains 15:25.
FNO_PAPER_AUTOMATION_LAST_ENTRY_TIME=14:30
